#!/usr/local/bin/python
"""Trusted, fixed evaluator for MLAC TransformerBlock checkpoint bundles."""
from __future__ import annotations
import argparse
import json
import math
import os
import re
import sys
import time
from pathlib import Path
import torch
from mlac.transformer import TransformerBlock
from mlac.modification import Modification, modify_model
from mlac.weight_engine import WeightOptimizationPlan, WeightOptimizationStep, optimize_weights
from mlac.attestation import canonical_json, directory_digests, sign_worker_result

MAX_ARTIFACT_BYTES = 512 * 1024 * 1024
NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$")

def artifact(root: Path, name: object) -> Path:
    if not isinstance(name, str) or not NAME.fullmatch(name) or name in {".", ".."}:
        raise ValueError("artifact references must be simple file names")
    path = root / name
    if path.is_symlink() or not path.is_file():
        raise ValueError(f"artifact is missing or is a symlink: {name}")
    if path.stat().st_size > MAX_ARTIFACT_BYTES:
        raise ValueError(f"artifact exceeds {MAX_ARTIFACT_BYTES} bytes: {name}")
    return path

def load_tensor(path: Path) -> torch.Tensor:
    value = torch.load(path, map_location="cpu", weights_only=True)
    if not isinstance(value, torch.Tensor) or not torch.is_floating_point(value) or not torch.isfinite(value).all():
        raise ValueError(f"{path.name} must contain one finite floating-point tensor")
    return value

def load_state(path: Path) -> dict:
    value = torch.load(path, map_location="cpu", weights_only=True)
    if not isinstance(value, dict) or not value or any(
        not isinstance(k, str) or not isinstance(v, torch.Tensor) for k, v in value.items()
    ):
        raise ValueError(f"{path.name} must contain a tensor-only state_dict")
    return value

def load_model(config: dict, state_path: Path) -> TransformerBlock:
    model = TransformerBlock(d_model=config["d_model"], num_heads=config["num_heads"],
        mlp_ratio=config["mlp_ratio"], dropout=config["dropout"])
    model.load_state_dict(load_state(state_path), strict=True)
    return model.eval()

def load_candidate(config: dict, baseline_path: Path, candidate_path: Path, manifest_path: Path) -> TransformerBlock:
    baseline = load_model(config, baseline_path)
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    if (
        not isinstance(manifest, dict)
        or set(manifest) != {"schema_version", "operation", "parameters"}
        or isinstance(manifest.get("schema_version"), bool)
        or manifest.get("schema_version") != 1
        or not isinstance(manifest.get("parameters"), dict)
    ):
        raise ValueError("candidate_manifest.json must match schema version 1")
    operation, params = manifest["operation"], manifest["parameters"]
    if operation == "profile_model":
        if set(params) - {"warmup_iterations", "measurement_iterations"}:
            raise ValueError("profile candidate contains unsupported parameters")
        warmup = params.get("warmup_iterations", 5)
        iterations = params.get("measurement_iterations", 30)
        if isinstance(warmup, bool) or not isinstance(warmup, int) or not 0 <= warmup <= 1000:
            raise ValueError("profile warmup_iterations must be between 0 and 1000")
        if isinstance(iterations, bool) or not isinstance(iterations, int) or not 1 <= iterations <= 1000:
            raise ValueError("profile measurement_iterations must be between 1 and 1000")
        candidate = baseline
    elif operation == "prune_attention_heads":
        heads = params.get("heads_to_prune")
        if (
            set(params) != {"module_name", "heads_to_prune"}
            or params["module_name"] != "attention"
            or not isinstance(heads, list) or not heads
            or any(isinstance(head, bool) or not isinstance(head, int) or head < 0 for head in heads)
            or len(set(heads)) != len(heads)
            or any(head >= baseline.attention.num_heads for head in heads)
            or len(heads) >= baseline.attention.num_heads
        ):
            raise ValueError("prune manifest must contain unique in-range heads for top-level attention")
        candidate = modify_model(
            baseline, Modification("prune_attention_heads", {"heads": heads})
        ).module
    elif operation == "resize_attention_heads":
        count = params.get("num_heads")
        if set(params) != {"num_heads"} or isinstance(count, bool) or not isinstance(count, int) or not 1 <= count <= 128:
            raise ValueError("resize_attention_heads manifest is invalid")
        candidate = modify_model(
            baseline, Modification("resize_attention_heads", {"num_heads": count})
        ).module
    elif operation == "resize_mlp_hidden":
        width = params.get("hidden_size")
        if set(params) != {"hidden_size"} or isinstance(width, bool) or not isinstance(width, int) or not 1 <= width <= 65536:
            raise ValueError("resize_mlp_hidden manifest is invalid")
        candidate = modify_model(
            baseline, Modification("resize_mlp_hidden", {"hidden_size": width})
        ).module
    elif operation == "set_mlp_activation":
        activation = params.get("activation")
        if set(params) != {"activation"} or not isinstance(activation, str) or activation not in {"gelu", "relu", "silu", "tanh"}:
            raise ValueError("set_mlp_activation manifest is invalid")
        candidate = modify_model(
            baseline, Modification("set_mlp_activation", {"activation": activation})
        ).module
    elif operation == "convert_mlp_to_moe":
        experts, top_k = params.get("num_experts"), params.get("top_k")
        noise = params.get("expert_noise_std", 1e-3)
        if (
            set(params) - {"num_experts", "top_k", "expert_noise_std"}
            or isinstance(experts, bool) or not isinstance(experts, int) or not 2 <= experts <= 32
            or isinstance(top_k, bool) or not isinstance(top_k, int) or not 1 <= top_k <= experts
            or isinstance(noise, bool) or not isinstance(noise, (int, float))
            or not math.isfinite(noise) or not 0 <= noise <= 0.05
        ):
            raise ValueError("convert_mlp_to_moe manifest is invalid")
        candidate = modify_model(
            baseline,
            Modification("convert_mlp_to_moe", {
                "num_experts": experts, "top_k": top_k, "expert_noise_std": noise,
            }),
        ).module
    elif operation in {"prune_unstructured", "prune_structured", "fake_quantize_int8", "inject_lora"}:
        target = params.get("target")
        parameter_targets = {
            "attention.qkv.weight", "attention.out_proj.weight",
            "mlp.0.weight", "mlp.0.bias", "mlp.2.weight", "mlp.2.bias",
        }
        module_targets = {"attention.qkv", "attention.out_proj", "mlp.0", "mlp.2"}
        if operation == "prune_unstructured":
            amount = params.get("amount")
            if set(params) != {"target", "amount"} or target not in parameter_targets:
                raise ValueError("prune_unstructured manifest target/fields are invalid")
            if isinstance(amount, bool) or not isinstance(amount, (int, float)) or not math.isfinite(amount) or not 0.0 < amount <= 0.5:
                raise ValueError("prune_unstructured amount must be in (0, 0.5]")
            config = {"amount": float(amount)}
        elif operation == "fake_quantize_int8":
            if set(params) != {"target"} or target not in parameter_targets:
                raise ValueError("fake_quantize_int8 manifest target/fields are invalid")
            config = {}
        elif operation == "prune_structured":
            dimension, indices = params.get("dimension"), params.get("indices")
            if set(params) != {"target", "dimension", "indices"} or target not in {
                "attention.qkv.weight", "attention.out_proj.weight", "mlp.0.weight", "mlp.2.weight"
            }:
                raise ValueError("prune_structured manifest target/fields are invalid")
            if dimension not in {"input", "output"} or not isinstance(indices, list) or not indices:
                raise ValueError("prune_structured dimension/indices are invalid")
            if any(isinstance(value, bool) or not isinstance(value, int) or value < 0 for value in indices) or len(set(indices)) != len(indices):
                raise ValueError("prune_structured indices must be unique non-negative integers")
            config = {"dimension": dimension, "indices": indices}
        else:
            rank, alpha, dropout = params.get("rank"), params.get("alpha"), params.get("dropout", 0.0)
            if set(params) - {"target", "rank", "alpha", "dropout"} or not {"target", "rank"}.issubset(params) or target not in module_targets:
                raise ValueError("inject_lora manifest target/fields are invalid")
            if isinstance(rank, bool) or not isinstance(rank, int) or not 1 <= rank <= 64:
                raise ValueError("inject_lora rank must be in [1, 64]")
            if alpha is None:
                alpha = rank
            if isinstance(alpha, bool) or not isinstance(alpha, (int, float)) or not math.isfinite(alpha) or not 0 < alpha <= 256:
                raise ValueError("inject_lora alpha must be in (0, 256]")
            if isinstance(dropout, bool) or not isinstance(dropout, (int, float)) or not math.isfinite(dropout) or not 0 <= dropout < 1:
                raise ValueError("inject_lora dropout must be in [0, 1)")
            config = {"rank": rank, "alpha": float(alpha), "dropout": float(dropout)}
        candidate = optimize_weights(
            baseline,
            WeightOptimizationPlan((WeightOptimizationStep(operation, target, config),)),
        ).model
    else:
        raise ValueError(f"unsupported candidate operation: {operation!r}")
    candidate.load_state_dict(load_state(candidate_path), strict=True)
    return candidate.eval()


def benchmark(model: TransformerBlock, sample: torch.Tensor, iterations: int, warmup: int):
    with torch.inference_mode():
        for _ in range(warmup): model(sample)
        start=time.perf_counter()
        output=None
        for _ in range(iterations): output=model(sample)
        latency=(time.perf_counter()-start)*1000.0/iterations
    assert output is not None
    return ({"parameter_count":sum(p.numel() for p in model.parameters()),
        "latency_ms_per_iteration":latency,"iterations":iterations,
        "output_shape":list(output.shape),"finite_output":bool(torch.isfinite(output).all().item())},output)

def main() -> int:
    parser=argparse.ArgumentParser()
    parser.add_argument("--candidate",required=True)
    parser.add_argument("--trusted",required=True)
    parser.add_argument("--report",required=True)
    parser.add_argument("--identity-key",required=True)
    parser.add_argument("--worker-id",required=True)
    parser.add_argument("--worker-image",required=True)
    args=parser.parse_args()
    if args.candidate != "/workspace/candidate.pt" or args.trusted != "/trusted" or args.report != "/output/report.json" or args.identity_key != "/identity/worker_ed25519_private.pem":
        raise ValueError("worker paths must match the fixed mount contract")
    candidate_root=Path("/workspace")
    candidate_path=artifact(candidate_root,"candidate.pt")
    candidate_manifest_path=artifact(candidate_root,"candidate_manifest.json")
    trusted=Path("/trusted").resolve(strict=True)
    manifest=json.loads(artifact(trusted,"manifest.json").read_text(encoding="utf-8"))
    required={"schema_version","architecture","baseline_state_dict","input_tensor","target_tensor","iterations","warmup"}
    if (not isinstance(manifest,dict) or isinstance(manifest.get("schema_version"),bool)
        or manifest.get("schema_version") != 1 or set(manifest) != required):
        raise ValueError("trusted manifest must match worker bundle schema version 1")
    config=manifest["architecture"]
    config_fields={"d_model","num_heads","mlp_ratio","dropout"}
    if not isinstance(config,dict) or set(config) != config_fields:
        raise ValueError("architecture must contain d_model, num_heads, mlp_ratio, dropout")
    if any(isinstance(config[k],bool) or not isinstance(config[k],int) or config[k]<1
        for k in ("d_model","num_heads","mlp_ratio")):
        raise ValueError("architecture integer fields must be positive")
    if config["d_model"] % config["num_heads"]: raise ValueError("d_model must be divisible by num_heads")
    dropout=config["dropout"]
    if isinstance(dropout,bool) or not isinstance(dropout,(int,float)) or not 0<=dropout<1:
        raise ValueError("dropout must be in [0, 1)")
    iterations,warmup=manifest["iterations"],manifest["warmup"]
    if isinstance(iterations,bool) or not isinstance(iterations,int) or not 1<=iterations<=500:
        raise ValueError("iterations must be in [1, 500]")
    if isinstance(warmup,bool) or not isinstance(warmup,int) or not 0<=warmup<=100:
        raise ValueError("warmup must be in [0, 100]")
    baseline_path=artifact(trusted,manifest["baseline_state_dict"])
    sample=load_tensor(artifact(trusted,manifest["input_tensor"]))
    target=load_tensor(artifact(trusted,manifest["target_tensor"]))
    if sample.ndim!=3 or sample.shape[-1]!=config["d_model"]:
        raise ValueError("input tensor must have shape [batch, sequence, d_model]")
    if target.shape!=sample.shape: raise ValueError("regression target tensor must match input tensor shape")
    baseline=load_model(config,baseline_path)
    candidate=load_candidate(config,baseline_path,candidate_path,candidate_manifest_path)
    baseline_metrics,baseline_output=benchmark(baseline,sample,iterations,warmup)
    candidate_metrics,candidate_output=benchmark(candidate,sample,iterations,warmup)
    with torch.inference_mode():
        base_mse=torch.nn.functional.mse_loss(baseline_output,target).item()
        candidate_mse=torch.nn.functional.mse_loss(candidate_output,target).item()
    if not math.isfinite(base_mse) or not math.isfinite(candidate_mse):
        raise ValueError("task quality calculation produced non-finite MSE")
    payload={"schema_version":1,"baseline":baseline_metrics,"candidate":candidate_metrics,
        "quality_baseline":{"score":-float(base_mse)},"quality_candidate":{"score":-float(candidate_mse)}}
    report_bytes=canonical_json(payload)
    attestation=sign_worker_result(report_bytes=report_bytes,
        artifact_sha256=directory_digests("/workspace","/trusted"),
        private_key_path=args.identity_key,worker_id=args.worker_id,worker_image=args.worker_image)
    envelope={"schema_version":1,"report":payload,"attestation":attestation}
    temporary=Path("/output/report.json.tmp")
    temporary.write_bytes(canonical_json(envelope))
    temporary.replace(Path("/output/report.json"))
    return 0

if __name__=="__main__":
    try: raise SystemExit(main())
    except Exception as exc:
        print(f"mlac-worker: {type(exc).__name__}: {exc}",file=sys.stderr)
        raise SystemExit(2)
