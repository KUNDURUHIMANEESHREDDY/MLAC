#!/usr/local/bin/python
"""Trusted fixed evaluator for local Hugging Face causal-LM checkpoints."""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

import torch
from safetensors.torch import load_file
from transformers import AutoConfig, AutoModelForCausalLM, AutoTokenizer

from mlac.attestation import canonical_json, directory_digests, sign_worker_result
from mlac.lm_evaluation import evaluate_language_models

MAX_ARTIFACT_BYTES = 512 * 1024 * 1024
NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$")


def artifact(root: Path, name: object) -> Path:
    if not isinstance(name, str) or not NAME.fullmatch(name) or name in {".", ".."}:
        raise ValueError("artifact references must be simple file names")
    path = root / name
    if path.is_symlink() or not path.is_file():
        raise ValueError(f"artifact is missing or is a symlink: {name}")
    if path.stat().st_size > MAX_ARTIFACT_BYTES:
        raise ValueError(f"artifact exceeds {MAX_ARTIFACT_BYTES} bytes: {name}")
    return path


def load_model(model_type: str, config_data: dict, weights: Path):
    if not isinstance(model_type, str) or not re.fullmatch(r"[A-Za-z0-9_]+", model_type):
        raise ValueError("model_type is invalid")
    if not isinstance(config_data, dict) or len(config_data) > 256:
        raise ValueError("model_config must be a bounded JSON object")
    config = AutoConfig.for_model(model_type, **config_data)
    model = AutoModelForCausalLM.from_config(config, trust_remote_code=False)
    state = load_file(str(weights), device="cpu")
    if not isinstance(state, dict) or not state:
        raise ValueError("safetensors checkpoint must contain a non-empty state dictionary")
    model.load_state_dict(state, strict=True)
    return model.eval()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--candidate", required=True)
    parser.add_argument("--trusted", required=True)
    parser.add_argument("--report", required=True)
    parser.add_argument("--identity-key", required=True)
    parser.add_argument("--worker-id", required=True)
    parser.add_argument("--worker-image", required=True)
    args = parser.parse_args()
    if (args.candidate != "/workspace/candidate.pt" or args.trusted != "/trusted"
        or args.report != "/output/report.json"
        or args.identity_key != "/identity/worker_ed25519_private.pem"):
        raise ValueError("worker paths must match the fixed mount contract")
    candidate_root = Path("/workspace")
    trusted = Path("/trusted").resolve(strict=True)
    manifest = json.loads(artifact(trusted, "manifest.json").read_text(encoding="utf-8"))
    required = {"schema_version", "model_type", "model_config", "baseline_state_dict",
                "dataset", "max_sequence_length", "iterations", "warmup"}
    if (not isinstance(manifest, dict) or isinstance(manifest.get("schema_version"), bool)
        or manifest.get("schema_version") != 2 or set(manifest) != required):
        raise ValueError("trusted manifest must match language-model bundle schema version 2")
    model_type = manifest["model_type"]
    config = manifest["model_config"]
    baseline_path = artifact(trusted, manifest["baseline_state_dict"])
    dataset_path = artifact(trusted, manifest["dataset"])
    candidate_path = artifact(candidate_root, "candidate.pt")
    tokenizer = AutoTokenizer.from_pretrained(
        str(trusted), local_files_only=True, trust_remote_code=False
    )
    if tokenizer.pad_token_id is None and tokenizer.eos_token_id is not None:
        tokenizer.pad_token = tokenizer.eos_token
    baseline = load_model(model_type, config, baseline_path)
    candidate = load_model(model_type, config, candidate_path)
    records = []
    with dataset_path.open("r", encoding="utf-8") as stream:
        for line_number, line in enumerate(stream, 1):
            if line_number > 10000:
                raise ValueError("dataset exceeds 10000 records")
            records.append(json.loads(line))
    report = evaluate_language_models(
        baseline, candidate, tokenizer, records,
        max_sequence_length=manifest["max_sequence_length"],
        iterations=manifest["iterations"], warmup=manifest["warmup"],
    )
    report_bytes = canonical_json(report)
    attestation = sign_worker_result(
        report_bytes=report_bytes,
        artifact_sha256=directory_digests(candidate_root, trusted),
        private_key_path=args.identity_key,
        worker_id=args.worker_id,
        worker_image=args.worker_image,
    )
    envelope = {"schema_version": 1, "report": report, "attestation": attestation}
    temporary = Path("/output/report.json.tmp")
    temporary.write_bytes(canonical_json(envelope))
    temporary.replace(Path("/output/report.json"))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"mlac-lm-worker: {type(exc).__name__}: {exc}", file=sys.stderr)
        raise SystemExit(2)
