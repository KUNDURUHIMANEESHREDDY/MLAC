# Public DNS A/AAAA records must point to this host.
MLAC_DOMAIN=mlac.example.com
MLAC_IMAGE=ghcr.io/kunduruhimaneeshreddy/mlac:sha-REPLACE_WITH_MAIN_COMMIT

# Configure with the exact issuer, audience, and JWKS URL from your OIDC provider.
MLAC_API_JWKS_URL=https://identity.example.com/.well-known/jwks.json
MLAC_API_ISSUER=https://identity.example.com/
MLAC_API_AUDIENCE=mlac-production
MLAC_REASONING_PROVIDER=rules

# Use a long random password and a URL-encoded password in this private URL.
MLAC_REDIS_PASSWORD=replace-with-a-long-random-secret
MLAC_RATE_LIMIT_REDIS_URL=redis://:replace-with-a-long-random-secret@redis:6379/0

# S3 bucket must have versioning and Object Lock enabled before backups are run.
MLAC_BACKUP_S3_BUCKET=replace-with-object-lock-bucket
MLAC_BACKUP_RETENTION_DAYS=90
AWS_REGION=ap-south-1
# Optional: KMS key ARN/ID. Without this, backups use SSE-S3 AES256.
# MLAC_BACKUP_KMS_KEY_ID=arn:aws:kms:ap-south-1:123456789012:key/...
